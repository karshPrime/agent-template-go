var rootCmd = &cobra.Command{
    Use:   "{{ project_slug }}",
    Short: "{{ project_description }}",
    Run: func(cmd *cobra.Command, args []string) {
{% if include_database %}
        db, err := database.Connect()
        if err != nil {
            fmt.Fprintf(os.Stderr, "database error: %v\n", err)
