package database

import (
	"github.com/ncruces/go-sqlite3/gormlite"
	"gorm.io/gorm"
)

// Connect opens the SQLite database and runs auto-migrations.
func Connect() (*gorm.DB, error) {
	db, err := gorm.Open(gormlite.Open("{{ project_slug }}.db"), &gorm.Config{})
	if err != nil {
		return nil, err
	}

	// TODO add model migrations
	// db.AutoMigrate(&YourModel{})

	return db, nil
}
